# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=

# Model ids from the Build with Gemini 4 Builder Guide (defaults shown; only set to override).
# GEMINI_LIVE_MODEL=gemini-3.8-live            # voice + camera call, calls tools
# GEMINI_CARBON_MODEL=gemini-4-carbon          # builds + repairs the measured 3D model
# GEMINI_NEON_MODEL=gemini-4-neon              # reads the room, resolves dimensions, critiques renders
# GEMINI_HYDROGEN_MODEL=gemini-4-hydrogen      # typed chat agent + parallel spec-reading workers
# GEMINI_DECISION_MODEL=gemini-decision-1      # Decisions API: frame gate, product ranking, 3D likeness score
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1    # places the product into the shopper's camera frame

# Public Shopify storefronts used for product discovery (comma separated).
SHOPIFY_STORES=www.albanypark.com,www.burrow.com,www.walkeredison.com,www.tribesigns.com,floydhome.com,www.schoolhouse.com

# ---- Rucha fills these (dev store for real test transactions) ----
# SHOPIFY_DEV_STORE=your-store.myshopify.com
# SHOPIFY_STOREFRONT_TOKEN=
# SHOPIFY_ADMIN_TOKEN=
